{
  "permissions": {
    "allow": [
      "Bash(npm run sync*)",
      "Bash(npm run limit*)",
      "Bash(npm run publish*)",
      "Bash(npm run token:refresh*)",
      "Bash(node scripts/*)",
      "Bash(node -e *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Read(.claude/**)",
      "Read(data/*.md)",
      "Read(data/reference/**)",
      "Read(data/patterns/**)",
      "Edit(data/*.md)",
      "Write(data/*.md)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(data/drafts.json)",
      "Read(data/posts.json)",
      "Read(data/archive/**)",
      "Read(dist/**)"
    ]
  }
}
